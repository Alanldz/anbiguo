# =============================================================================
# .env.example · 环境配置样例（客户端 API + 用户后台 API 共用一套 Laravel 应用）
# -----------------------------------------------------------------------------
# 使用方式：cp .env.example .env && php artisan key:generate
# ⚠️ 约定（docs/06-后台隔离与权限设计.md §二）：
#    本文件服务于 api.xxx.com（/api/v1）与 console.xxx.com（/console-api/v1）
#    总后台 admin.xxx.com 是【独立应用】，有自己的 .env，见 admin/api/.env.example
# ⚠️ 严禁把任何 KEY / SECRET 写进代码或提交到仓库
#    业务所需的第三方 KEY 一律存 sys_configs 表，在总后台配置中心可视化修改
# =============================================================================

APP_NAME="安必果刷题"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai
APP_URL=https://api-test.anbiguo.com

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

# -----------------------------------------------------------------------------
# 日志
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=30

# -----------------------------------------------------------------------------
# 数据库（客户端与用户后台统一使用 app_client / app_console 账号，均无 sys_ 表权限）
# 生产环境请分别配置：api 站点用 app_client，console 站点用 app_console
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=anbiguo
DB_USERNAME=app_client
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# 严格模式 + 时区，与 docs/03 规范一致
DB_STRICT=true
DB_TIMEZONE=+08:00
DB_PREFIX=

# 仅部署与运维时临时使用（有 DDL 权限，日常运行不得使用）
# DB_MIGRATE_USERNAME=app_admin
# DB_MIGRATE_PASSWORD=

# -----------------------------------------------------------------------------
# 缓存 / 队列 / 会话（Redis 7）
# -----------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=anbiguo_

CACHE_STORE=redis
CACHE_PREFIX=anbiguo_cache

QUEUE_CONNECTION=redis
QUEUE_DEFAULT=default
QUEUE_RETRY_AFTER=90

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=.anbiguo.com
SESSION_SECURE_COOKIE=true

# -----------------------------------------------------------------------------
# 三端 JWT 签名密钥（必须是【三个不同的】随机长字符串，且与总后台的密钥不同）
# 生成方式：php -r "echo bin2hex(random_bytes(32));"
# -----------------------------------------------------------------------------
JWT_SECRET_CLIENT=
JWT_SECRET_CONSOLE=
JWT_TTL_CLIENT=10080
JWT_TTL_CONSOLE=120
JWT_ISSUER=anbiguo

# -----------------------------------------------------------------------------
# 配置中心加密密钥（用于 sys_configs 中 is_secret=1 的字段 AES-256-GCM 加解密）
# ⚠️ 一旦启用不可随意更换，否则已加密的第三方密钥将无法解密
# 生成方式：php -r "echo base64_encode(random_bytes(32));"
# -----------------------------------------------------------------------------
CONFIG_ENCRYPT_KEY=

# -----------------------------------------------------------------------------
# 跨域（客户端 H5 与两个后台前端分别部署在不同域名）
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://console-test.anbiguo.com,http://localhost:5173

# -----------------------------------------------------------------------------
# 限流（见 docs/04 §2.5）
# -----------------------------------------------------------------------------
THROTTLE_SMS_PER_MINUTE=1
THROTTLE_SMS_PER_DAY=10
THROTTLE_API_PER_MINUTE=120

# -----------------------------------------------------------------------------
# 存储兜底配置（真实生效值存 sys_configs，这里仅用于本地开发与配置中心读取失败时降级）
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=storage/app/private

# -----------------------------------------------------------------------------
# 初始管理员密码（仅 db:seed 首次创建 admin 账号时使用，登录后必须立即修改）
# -----------------------------------------------------------------------------
ADMIN_INIT_PASSWORD=

# -----------------------------------------------------------------------------
# 调试辅助（生产环境必须为 false，否则短信验证码会直接返回给前端）
# -----------------------------------------------------------------------------
SMS_DEBUG_SHOW_CODE=false
