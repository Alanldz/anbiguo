{
    "name": "anbiguo/admin-api",
    "description": "识途刷题 · 总管理后台（独立 Laravel 应用，docs/06 §二）",
    "type": "project",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.31",
        "firebase/php-jwt": "^6.10",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "laravel/pint": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Database\\Seeders\\": "database/seeders/",
            "Database\\Factories\\": "database/factories/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-config --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pixelfed/laravel-ns-auditor": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
