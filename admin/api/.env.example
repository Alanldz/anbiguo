# ----------------------------------------------------------------------------
# 识途刷题 · 总管理后台（独立应用，docs/06 §二）
# 复制本文件为 .env 后填写。⚠️ 不要提交真实 .env 到仓库。
# ----------------------------------------------------------------------------

APP_NAME="识途刷题总后台"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://admin.localhost
APP_TIMEZONE=Asia/Shanghai
APP_LOCALE=zh_CN

# ⚠️ 必须与主应用 server/.env 的 APP_KEY 完全一致！
# 原因：sys_configs 的 is_secret=1 字段用 Crypt（AES-256-CBC）加密，
#       总后台改密文、主应用读取解密，两端必须共享同一密钥，否则解密失败。
APP_KEY=

# 维护模式
APP_MAINTENANCE_DRIVER=file

# ----------------------------------------------------------------------------
# 数据库：使用 app_admin 账号（唯一能读写 sys_* 表的账号，docs/06 §二）
# ----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=anbiguo
DB_USERNAME=app_admin
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=
DB_TIMEZONE=+08:00

# ----------------------------------------------------------------------------
# Redis：与主应用【同实例同前缀】
# 原因：配置缓存键 sys_config:group:{group} 必须总后台与主应用一致，
#       总后台改配置主应用才能立即失效/命中（docs/04 §2.2、API-ADM-041）。
# ----------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# ⚠️ 必须与主应用 server/.env 的 CACHE_PREFIX 完全一致（默认 anbiguo_cache）
CACHE_PREFIX=anbiguo_cache
CACHE_STORE=redis

# ----------------------------------------------------------------------------
# JWT：总后台独立密钥，必须与 CLIENT/CONSOLE 不同！
# 原因：Token 通过 scp=admin 作用域 + 独立密钥，从机制上禁止跨端复用（docs/06 §二）。
# ----------------------------------------------------------------------------
JWT_ISSUER=anbiguo
JWT_SECRET_ADMIN=
JWT_TTL_ADMIN=30

# ----------------------------------------------------------------------------
# 日志 / 跨域
# ----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30

CORS_ALLOWED_ORIGINS=http://admin.localhost

# ----------------------------------------------------------------------------
# 总后台 IP 白名单（config/admin.php ip_whitelist，docs/06 §八 安全加固项）
# 逗号分隔，支持单个 IP 或 CIDR 网段；留空 = 白名单关闭，全部放行（默认）。
# 示例：ADMIN_IP_WHITELIST=203.0.113.10,198.51.100.0/24
# ----------------------------------------------------------------------------
ADMIN_IP_WHITELIST=

# 初始管理员密码（SystemInitSeeder 使用，未配置则 Admin@123456；首次登录后必须修改）
ADMIN_INIT_PASSWORD=Admin@123456
